# Cloudflare Pages headers
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# The web app manifest must be served as JSON, never as HTML from the SPA fallback.
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600

# The service worker must never be cached, or updates never arrive.
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

# Hashed build assets are immutable.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The vendored WebTorrent bundle is versioned by filename; keep it long-lived.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
